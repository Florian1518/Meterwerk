FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS migrations
WORKDIR /app
ARG VERSION
ARG GIT_SHA
ARG BUILD_TIMESTAMP
LABEL org.opencontainers.image.source=https://github.com/Florian1518/Meterwerk \
  org.opencontainers.image.version=$VERSION \
  org.opencontainers.image.revision=$GIT_SHA \
  org.opencontainers.image.created=$BUILD_TIMESTAMP \
  org.opencontainers.image.base.name=node:22-alpine
# The package manager is installed only for image construction.
ENV COREPACK_HOME=/opt/corepack
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --prod
COPY prisma ./prisma
COPY prisma.config.ts ./prisma.config.ts
COPY scripts/verify-migration-baseline.mjs ./scripts/verify-migration-baseline.mjs
COPY scripts/staging-create-admin.ts ./scripts/staging-create-admin.ts
COPY src/server/password.ts src/server/staging-admin.ts src/server/staging-database.mjs ./src/server/
# Generation requires a URL syntactically, but never connects to a database.
RUN DATABASE_URL=postgresql://build@127.0.0.1:5432/build node node_modules/prisma/build/index.js generate
RUN mkdir -p /app/src/generated \
  && chown -R node:node /app \
  && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/corepack /opt/yarn-* \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/pnpm /usr/local/bin/yarn /usr/local/bin/yarnpkg
ENV NODE_ENV=production \
  BUILD_VERSION=$VERSION GIT_COMMIT_SHA=$GIT_SHA BUILD_TIMESTAMP=$BUILD_TIMESTAMP
USER node
# No automatic schema mutation on container start.
CMD ["node", "node_modules/prisma/build/index.js", "--version"]
