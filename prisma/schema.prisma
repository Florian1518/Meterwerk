generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  MANAGER
  USER
}

enum MeterType {
  ELECTRICITY
  WATER
  GAS
  HEAT
}

enum MeterStatus {
  ACTIVE
  OFFLINE
  MAINTENANCE
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  WARNING
  MAINTENANCE
  DISABLED
}

enum DeviceProtocol {
  VIRTUAL
  REST
  MQTT
  MODBUS
  MBUS
  WMBUS
  LORAWAN
  VENDOR_API
  MODBUS_RTU
  MODBUS_TCP
  PULSE
}

enum ProtocolMode {
  POLLING
  EVENT
}

enum SecurityMode {
  NONE
  OMS_AES128
  TLS
  API_KEY
  OAUTH2
}

enum Quality {
  VALID
  ESTIMATED
  INVALID
  SUSPECT
}

enum DataQualityStatus {
  OK
  WARNING
  ERROR
}

enum DataQualityIssueType {
  MISSING_READINGS
  DUPLICATE_READINGS
  TIMESTAMP_OUT_OF_RANGE
  NEGATIVE_CONSUMPTION
  UNUSUAL_JUMP
  COUNTER_ROLLBACK
  UNIT_MISMATCH
  ORPHANED_ASSIGNMENT
  DATA_GAP
}

enum DataCorrectionAction {
  CORRECT
  MARK_INVALID
  REPLACE
}

enum Source {
  DEMO
  REST
  MQTT
  GATEWAY
  MANUAL
}

enum DeviceTokenStatus {
  ACTIVE
  REVOKED
}

enum AlarmStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum RuleTrigger {
  READING_CREATED
  ALARM_CREATED
  ALARM_STATUS_CHANGED
  METER_ONLINE
  METER_OFFLINE
  GATEWAY_ONLINE
  GATEWAY_OFFLINE
  SCHEDULED_CHECK
}

enum RuleExecutionStatus {
  RUNNING
  SUCCEEDED
  SKIPPED
  FAILED
}

enum AnalyticsAnomalyStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum DashboardVisibility {
  PRIVATE
  TENANT
  ROLE_BASED
}

enum ReportType {
  MONTHLY
  YEARLY
  CONSUMPTION
  COST
  METER_STATUS
  ALARM
  PROPERTY
}

enum ReportDelivery {
  PORTAL
  EMAIL
}

enum NotificationChannel {
  PORTAL
  EMAIL
  SMS
  PUSH
  WEBHOOK
}

enum PlanCode {
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum FeatureKey {
  REPORTING
  ANALYTICS
  API
  WEBHOOKS
  ADVANCED_EXPORTS
}

enum SupportLevel {
  STANDARD
  PRIORITY
  DEDICATED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  PAUSED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Tenant {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  createdAt       DateTime         @default(now())
  users           User[]
  properties      Property[]
  gateways        Gateway[]
  devices         Device[]
  workerHealth    WorkerHealth[]
  technicalAlerts TechnicalAlert[]
  tariffs         Tariff[]
  profiles        DeviceProfile[]
  reports         Report[]
  reportSchedules ReportSchedule[]
  notes           Note[]
  attachments     Attachment[]
  invitations     Invitation[]
  subscriptions   Subscription[]
  featureOverrides TenantFeatureOverride[]
  planOverride    TenantPlanOverride?
  usageCounters   TenantUsageCounter[]
  publicApiKeys   PublicApiKey[]
  webhooks        WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  dataImports     DataImport[]
  dataQualityFindings DataQualityFinding[]
  dataQualityCorrections DataQualityCorrection[]
  rules           Rule[]
  ruleExecutions  RuleExecution[]
  ruleActionJobs  RuleActionJob[]
  ruleVersions RuleVersion[]
  analyticsAnomalies AnalyticsAnomaly[]
  dashboards Dashboard[]
}

model DataImport {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId     String
  actorName   String   @default("")
  fileName    String   @default("Unbekannt (Altbestand)")
  successCount Int     @default(0)
  errorCount  Int      @default(0)
  skippedCount Int     @default(0)
  skippedRows Json     @default("[]")
  resource    String
  fingerprint String
  stagedData  Json
  errors      Json
  rowCount    Int
  status      String   @default("PREVIEWED")
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, fingerprint])
}

model WebhookEndpoint {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  url            String
  events         String[] @default([])
  active         Boolean  @default(true)
  secretCiphertext String
  secretIv       String
  secretTag      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastDeliveryAt DateTime?
  deletedAt      DateTime?
  deliveries     WebhookDelivery[]

  @@unique([id, tenantId])
  @@index([tenantId, active])
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  tenantId       String
  webhookId      String
  webhook        WebhookEndpoint @relation(fields: [webhookId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event          String
  eventId        String
  payload        Json
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  lastAttemptAt  DateTime?
  lockedUntil    DateTime?
  statusCode     Int?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([webhookId, eventId])
  @@index([tenantId, status, nextAttemptAt])
  @@index([webhookId, createdAt])
}

model PublicApiKey {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  keyHash     String   @unique
  scopes      String[] @default([])
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rateLimit   PublicApiRateLimit?

  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
}

model PublicApiRateLimit {
  keyId     String      @id
  tenantId  String
  attempts  Int         @default(0)
  resetAt   DateTime
  apiKey    PublicApiKey @relation(fields: [keyId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([keyId, tenantId])
  @@index([tenantId])
}

model TenantUsageCounter {
  tenantId String
  month String
  kind String
  count Int @default(0)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, month, kind])
}

model Plan {
  id                 String       @id @default(cuid())
  code               PlanCode     @unique
  name               String
  maxProperties      Int
  maxMeters          Int
  maxUsers           Int
  maxGateways        Int
  maxBuildings       Int @default(2147483647)
  maxUnits           Int @default(2147483647)
  maxDevices         Int @default(2147483647)
  supportLevel       SupportLevel @default(STANDARD)
  monthlyPrice       Decimal?     @db.Decimal(12, 2)
  yearlyPrice        Decimal?     @db.Decimal(12, 2)
  priceCurrency      String?      @db.VarChar(3)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  features           PlanFeature[]
  subscriptions      Subscription[]
}

model PlanFeature {
  planId   String
  feature  FeatureKey
  enabled  Boolean @default(false)
  plan     Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, feature])
}

model Subscription {
  id         String             @id @default(cuid())
  tenantId   String
  planId     String
  status     SubscriptionStatus @default(ACTIVE)
  startsAt   DateTime           @default(now())
  endsAt     DateTime?
  trialEndsAt DateTime?
  billingInterval BillingInterval @default(MONTHLY)
  priceAmount Decimal? @db.Decimal(12, 2)
  priceCurrency String? @db.VarChar(3)
  billingContactName String?
  billingContactEmail String?
  billingContactCompany String?
  billingContactAddress String?
  externalBillingId String? @unique
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan       Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, startsAt])
  @@index([planId])
}

model TenantFeatureOverride {
  tenantId  String
  feature   FeatureKey
  enabled   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, feature])
}

model TenantPlanOverride {
  tenantId      String   @id
  maxProperties Int?
  maxMeters     Int?
  maxUsers      Int?
  maxGateways   Int?
  maxBuildings  Int?
  maxUnits      Int?
  maxDevices    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id           String          @id @default(cuid())
  tenantId     String?
  tenant       Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name         String
  email        String          @unique
  passwordHash String
  role         Role            @default(USER)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  sessions     Session[]
  grants       PropertyGrant[]
  reports      Report[] @relation("ReportCreator")
  reportSchedules ReportSchedule[]
  notes        Note[]
  attachments  Attachment[]
  mfaEnabled Boolean @default(false)
  mfaSecretEncrypted String?
  mfaConfiguredAt DateTime?
  mfaRecoveryCodes MfaRecoveryCode[]
  passwordResetTokens PasswordResetToken[]
  invitationsCreated Invitation[] @relation("InvitationCreator")
  invitationsAccepted Invitation[] @relation("InvitationAcceptor")
  notificationPreferences NotificationPreference[]
  loginHistory LoginHistory[]
  ownedDashboards Dashboard[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model Dashboard {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name        String
  description String
  visibility  DashboardVisibility @default(PRIVATE)
  roles       Role[]
  widgets     DashboardWidget[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  @@unique([id, tenantId])
  @@index([tenantId, visibility])
  @@index([tenantId, ownerId])
}

model DashboardWidget {
  id          String    @id @default(cuid())
  tenantId    String
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId, tenantId], references: [id, tenantId], onDelete: Cascade)
  title       String
  type        String
  dataSource  String
  medium      MeterType?
  meterId     String?
  propertyId  String?
  period      String
  aggregation String
  unit        String?
  display     Json      @default("{}")
  filters     Json      @default("{}")
  positionX   Int       @default(0)
  positionY   Int       @default(0)
  width       Int       @default(4)
  height      Int       @default(3)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@unique([id, tenantId])
  @@index([tenantId, dashboardId, positionY, positionX])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  rotatedFromId String?
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model MfaRecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, usedAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model Invitation {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  role        Role      @default(USER)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  acceptedById String?
  acceptedBy  User?     @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User      @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  propertyIds Json      @default("[]")
  createdAt   DateTime  @default(now())
  @@index([tenantId, email, expiresAt])
}

model NotificationPreference {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  event     String
  enabled   Boolean            @default(true)
  createdAt DateTime           @default(now())
  @@unique([userId, channel, event])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  success   Boolean
  reason    String?
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@index([email, createdAt])
}

model LoginLimit {
  key      String   @id
  attempts Int      @default(0)
  resetAt  DateTime
}

model DeviceRateLimit {
  key      String   @id
  attempts Int      @default(0)
  resetAt  DateTime
}

model Property {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  address   String
  city      String
  createdAt DateTime        @default(now())
  buildings Building[]
  grants    PropertyGrant[]
  rules     Rule[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model PropertyGrant {
  tenantId   String
  userId     String
  propertyId String
  user       User     @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  property   Property @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([userId, propertyId])
  @@index([tenantId])
}

model Building {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  property   Property @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  name       String
  units      Unit[]

  @@unique([id, tenantId])
  @@index([tenantId, propertyId])
}

model Unit {
  id         String   @id @default(cuid())
  tenantId   String
  buildingId String
  building   Building @relation(fields: [buildingId, tenantId], references: [id, tenantId], onDelete: Restrict)
  name       String
  floor      String
  area       Decimal  @db.Decimal(12, 2)
  meters     Meter[]

  @@unique([id, tenantId])
  @@index([tenantId, buildingId])
}

model Meter {
  id               String             @id @default(cuid())
  tenantId         String
  unitId           String
  unit             Unit               @relation(fields: [unitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  serialNumber     String
  externalDeviceId String?
  type             MeterType
  manufacturer     String
  model            String
  measurementUnit  String
  location         String
  status           MeterStatus        @default(ACTIVE)
  lastContact      DateTime?
  installedAt      DateTime
  demoPricePerUnit Decimal            @db.Decimal(10, 4)
  readings         Reading[]
  qualityFindings  DataQualityFinding[]
  alarms           Alarm[]
  analyticsAnomalies AnalyticsAnomaly[]
  rules            Rule[]
  devices          Device[]
  utilityConfig    Json               @default("{}")
  tariffs          Tariff[]
  replacementsOut  MeterReplacement[] @relation("OldMeter")
  replacementsIn   MeterReplacement[] @relation("NewMeter")

  @@unique([id, tenantId])
  @@unique([tenantId, serialNumber])
  @@unique([tenantId, externalDeviceId])
  @@index([tenantId, unitId])
}

model Gateway {
  id                String              @id @default(cuid())
  tenantId          String
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name              String
  externalGatewayId String
  manufacturer      String
  model             String
  firmwareVersion   String?
  queueSize         Int                 @default(0)
  queueWarning      Boolean             @default(false)
  quarantineSize    Int                 @default(0)
  queueDropped      Int                 @default(0)
  status            DeviceStatus        @default(MAINTENANCE)
  lastSeenAt        DateTime?
  installedAt       DateTime
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  devices           Device[]
  credentials       GatewayCredential[]
  commands          GatewayCommand[]
  rules             Rule[]

  @@unique([id, tenantId])
  @@unique([tenantId, externalGatewayId])
  @@index([tenantId, status])
}

model GatewayCredential {
  id             String            @id
  tenantId       String
  gatewayId      String
  publicKey      String
  keyFingerprint String?
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  status         DeviceTokenStatus @default(ACTIVE)
  createdAt      DateTime          @default(now())
  gateway        Gateway           @relation(fields: [gatewayId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, gatewayId])
}

model WorkerHealth {
  tenantId           String    @id
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  heartbeatAt        DateTime
  mqttConnected      Boolean
  mqttDisconnectedAt DateTime?
  subscribed         Boolean
  errorStreak        Int       @default(0)
  lastIngestionAt    DateTime?
}

model TechnicalAlert {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind        String
  entityId    String
  active      Boolean   @default(true)
  openedAt    DateTime  @default(now())
  resolvedAt  DateTime?
  occurrences Int       @default(1)

  @@unique([tenantId, kind, entityId])
  @@index([tenantId, active])
}

model Device {
  id               String               @id @default(cuid())
  tenantId         String
  meterId          String
  gatewayId        String?
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  meter            Meter                @relation(fields: [meterId, tenantId], references: [id, tenantId], onDelete: Restrict)
  gateway          Gateway?             @relation(fields: [gatewayId, tenantId], references: [id, tenantId], onDelete: Restrict)
  externalDeviceId String
  manufacturer     String
  model            String
  firmwareVersion  String?
  protocol         DeviceProtocol
  status           DeviceStatus         @default(MAINTENANCE)
  lastSeenAt       DateTime?
  installedAt      DateTime
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  credentials      DeviceCredential[]
  readings         Reading[]
  modbusConfig     ModbusConfiguration?
  diagnostic       ModbusDiagnostic?
  telemetry        TelemetrySample[]
  commands         GatewayCommand[]
  profileId        String?
  profile          DeviceProfile?       @relation(fields: [profileId, tenantId], references: [id, tenantId], onDelete: Restrict)
  protocolConfig   Json                 @default("{}")
  protocolMode     ProtocolMode         @default(POLLING)
  pulseConfig      PulseConfig?
  wirelessConfig   WirelessMeterConfig?

  @@unique([id, tenantId])
  @@unique([tenantId, externalDeviceId])
  @@index([tenantId, meterId])
  @@index([tenantId, status])
}

model DeviceProfile {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  manufacturer  String
  model         String
  utility       MeterType
  protocol      DeviceProtocol
  version       Int            @default(1)
  capabilities  Json
  mapping       Json
  defaults      Json           @default("{}")
  firmwareNotes String?
  active        Boolean        @default(true)
  devices       Device[]

  @@unique([id, tenantId])
  @@unique([tenantId, manufacturer, model, version])
  @@index([tenantId, utility, protocol])
}

model PulseConfig {
  id              String    @id @default(cuid())
  tenantId        String
  deviceId        String    @unique
  device          Device    @relation(fields: [deviceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  impulsesPerUnit Decimal   @db.Decimal(20, 6)
  unit            String
  utility         MeterType
  debounceMs      Int       @default(50)
  rollover        Decimal?  @db.Decimal(20, 6)
  inputChannel    String
  lastCounter     Decimal?  @db.Decimal(20, 6)
  lastTimestamp   DateTime?

  @@unique([deviceId, tenantId])
  @@index([tenantId, utility])
}

model WirelessMeterConfig {
  id               String       @id @default(cuid())
  tenantId         String
  deviceId         String       @unique
  device           Device       @relation(fields: [deviceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  deviceIdValue    String
  manufacturerCode String
  encryptionKeyRef String?
  securityMode     SecurityMode @default(NONE)
  rssi             Int?
  snr              Decimal?     @db.Decimal(8, 3)
  receivedAt       DateTime?

  @@unique([deviceId, tenantId])
  @@index([tenantId, deviceIdValue])
}

model MeterReplacement {
  id                String   @id @default(cuid())
  tenantId          String
  oldMeterId        String
  newMeterId        String
  removedAt         DateTime
  removedRegister   Decimal  @db.Decimal(20, 6)
  installedAt       DateTime
  installedRegister Decimal  @db.Decimal(20, 6)
  reason            String
  documentation     String?
  actorId           String
  oldMeter          Meter    @relation("OldMeter", fields: [oldMeterId, tenantId], references: [id, tenantId], onDelete: Restrict)
  newMeter          Meter    @relation("NewMeter", fields: [newMeterId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, oldMeterId, removedAt])
  @@index([tenantId, newMeterId, installedAt])
}

model DeviceCredential {
  id         String            @id @default(cuid())
  tenantId   String
  deviceId   String
  device     Device            @relation(fields: [deviceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tokenHash  String            @unique
  status     DeviceTokenStatus @default(ACTIVE)
  createdAt  DateTime          @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([tenantId, deviceId, status])
}

model Reading {
  id              String        @id @default(cuid())
  tenantId        String
  meterId         String
  deviceId        String?
  messageId       String?
  meter           Meter         @relation(fields: [meterId, tenantId], references: [id, tenantId], onDelete: Restrict)
  device          Device?       @relation(fields: [deviceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  timestamp       DateTime
  registerValue   Decimal       @db.Decimal(20, 6)
  meterValue      Decimal?      @db.Decimal(20, 6)
  consumption     Decimal       @db.Decimal(20, 6)
  measurementUnit String
  source          Source
  quality         Quality       @default(VALID)
  receivedAt      DateTime      @default(now())
  measurements    Measurement[]
  qualityFindings DataQualityFinding[]
  corrections     DataQualityCorrection[]

  @@unique([id, tenantId])
  @@unique([tenantId, deviceId, messageId])
  @@unique([tenantId, meterId, timestamp, source])
  @@index([tenantId, timestamp])
  @@index([tenantId, id])
}

model DataQualityFinding {
  id          String                @id @default(cuid())
  tenantId    String
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meterId     String
  meter       Meter                 @relation(fields: [meterId, tenantId], references: [id, tenantId], onDelete: Cascade)
  readingId   String?
  reading     Reading?              @relation(fields: [readingId, tenantId], references: [id, tenantId], onDelete: Cascade)
  type        DataQualityIssueType
  status      DataQualityStatus
  fingerprint String
  description String
  details     Json                  @default("{}")
  windowFrom  DateTime
  windowTo    DateTime
  detectedAt  DateTime              @default(now())
  lastSeenAt  DateTime              @default(now())
  resolvedAt  DateTime?
  acknowledgedAt DateTime?
  acknowledgedBy String?
  acknowledgementReason String?

  @@unique([tenantId, fingerprint])
  @@unique([id, tenantId])
  @@index([tenantId, status, type, resolvedAt])
  @@index([tenantId, meterId, windowFrom, windowTo])
}

model DataQualityCorrection {
  id          String               @id @default(cuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  readingId   String
  reading     Reading              @relation(fields: [readingId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actorId     String
  action      DataCorrectionAction
  reason      String
  beforeData  Json
  afterData   Json
  createdAt   DateTime             @default(now())

  @@unique([id, tenantId])
  @@index([tenantId, readingId, createdAt])
}

model Measurement {
  id        String  @id @default(cuid())
  tenantId  String
  readingId String
  reading   Reading @relation(fields: [readingId, tenantId], references: [id, tenantId], onDelete: Cascade)
  metric    String
  rawValue  Decimal @db.Decimal(20, 6)
  rawUnit   String
  value     Decimal @db.Decimal(20, 6)
  unit      String
  quality   Quality

  @@unique([readingId, metric])
  @@index([tenantId, metric])
}

model Tariff {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  meterId    String?
  meter      Meter?    @relation(fields: [meterId, tenantId], references: [id, tenantId], onDelete: Restrict)
  utility    MeterType
  validFrom  DateTime
  validTo    DateTime?
  unit       String
  price      Decimal   @db.Decimal(20, 6)
  basePerDay Decimal   @default(0) @db.Decimal(20, 6)
  condition  Decimal?  @db.Decimal(12, 6)
  calorific  Decimal?  @db.Decimal(12, 6)

  @@index([tenantId, utility, validFrom])
}

model Alarm {
  id        String      @id @default(cuid())
  tenantId  String
  meterId   String
  meter     Meter       @relation(fields: [meterId, tenantId], references: [id, tenantId], onDelete: Restrict)
  title     String
  severity  String
  status    AlarmStatus @default(OPEN)
  createdAt DateTime    @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt DateTime?
  resolvedBy String?
  comment   String?
  comments  Note[]

  @@index([tenantId, status])
  @@unique([id, tenantId])
}

model AnalyticsAnomaly {
  id              String                @id @default(cuid())
  tenantId        String
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meterId         String
  meter           Meter                 @relation(fields: [meterId, tenantId], references: [id, tenantId], onDelete: Restrict)
  propertyId      String
  type            String
  medium          MeterType
  severity        String
  windowFrom      DateTime
  windowTo        DateTime
  measuredValue   Decimal               @db.Decimal(20, 6)
  expectedValue   Decimal               @db.Decimal(20, 6)
  deviationPercent Decimal?             @db.Decimal(20, 6)
  description     String
  detectedAt      DateTime              @default(now())
  status          AnalyticsAnomalyStatus @default(OPEN)
  comment         String?
  resolvedAt      DateTime?
  acknowledgedAt DateTime?
  fingerprint     String
  @@unique([tenantId, fingerprint])
  @@unique([id, tenantId])
  @@index([tenantId, status, detectedAt])
  @@index([tenantId, meterId, windowFrom, windowTo])
}

model Rule {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId  String?
  property    Property?   @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: Cascade)
  meterId     String?
  meter       Meter?      @relation(fields: [meterId, tenantId], references: [id, tenantId], onDelete: Cascade)
  gatewayId   String?
  gateway     Gateway?    @relation(fields: [gatewayId, tenantId], references: [id, tenantId], onDelete: Cascade)
  medium      MeterType?
  name        String
  description String
  active      Boolean     @default(true)
  trigger     RuleTrigger
  conditions  Json        @default("[]")
  actions     Json        @default("[]")
  priority    Int         @default(100)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  executions  RuleExecution[]
  versions    RuleVersion[]
  actionJobs  RuleActionJob[]
  cooldownSeconds Int @default(0)
  maxExecutionsPerHour Int @default(0)
  scheduleIntervalSeconds Int @default(300)
  nextScheduledAt DateTime?
  lastExecutedAt DateTime?

  @@unique([id, tenantId])
  @@index([tenantId, active, priority])
  @@index([tenantId, trigger, active])
}

model RuleVersion {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ruleId      String
  rule        Rule     @relation(fields: [ruleId, tenantId], references: [id, tenantId], onDelete: Cascade)
  version     Int
  definition  Json
  createdAt   DateTime @default(now())
  @@unique([id, tenantId])
  @@unique([ruleId, tenantId, version])
  @@index([tenantId, ruleId, createdAt])
}

model RuleExecution {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ruleId      String
  rule        Rule      @relation(fields: [ruleId, tenantId], references: [id, tenantId], onDelete: Cascade)
  trigger     RuleTrigger
  eventKey    String
  matched     Boolean
  actionCount Int       @default(0)
  details     Json      @default("{}")
  executedAt  DateTime  @default(now())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  status      RuleExecutionStatus @default(RUNNING)
  executedActions Json @default("[]")
  skippedActions Json @default("[]")
  error       String?
  correlationId String
  ruleVersion Int @default(1)
  actionJobs   RuleActionJob[]

  @@unique([id, tenantId])
  @@index([tenantId, ruleId, executedAt])
  @@index([tenantId, eventKey])
}

model RuleActionJob {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ruleId      String
  rule        Rule     @relation(fields: [ruleId, tenantId], references: [id, tenantId], onDelete: Cascade)
  executionId String
  execution   RuleExecution @relation(fields: [executionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  type        String
  payload     Json
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  nextAttemptAt DateTime @default(now())
  lockedUntil DateTime?
  lastError   String?
  correlationId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([id, tenantId])
  @@index([tenantId, status, nextAttemptAt])
  @@index([tenantId, executionId])
}

model Report {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User         @relation("ReportCreator", fields: [createdById], references: [id], onDelete: Restrict)
  type        ReportType
  title       String
  periodFrom  DateTime
  periodTo    DateTime
  filters     Json         @default("{}")
  status      String       @default("READY")
  content     Json         @default("{}")
  createdAt   DateTime     @default(now())
  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
}

model ReportSchedule {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  type        ReportType
  delivery    ReportDelivery @default(PORTAL)
  dayOfMonth  Int?
  active      Boolean       @default(true)
  filters     Json          @default("{}")
  lastRunAt   DateTime?
  createdAt   DateTime      @default(now())
  @@unique([id, tenantId])
  @@index([tenantId, active])
}

model Note {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  targetType String
  entityId   String
  text       String
  createdAt  DateTime @default(now())
  alarmId    String?
  alarm      Alarm?   @relation(fields: [alarmId, tenantId], references: [id, tenantId], onDelete: Cascade)
  @@unique([id, tenantId])
  @@index([tenantId, targetType, entityId, createdAt])
}

model Attachment {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  targetType String
  entityId   String
  fileName   String
  contentType String
  storageKey String
  sizeBytes  Int
  createdAt  DateTime @default(now())
  @@unique([id, tenantId])
  @@index([tenantId, targetType, entityId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  tenantId  String?
  actorId   String
  action    String
  entityId  String
  details   Json     @default("{}")
  correlationId String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

enum CommissioningStatus {
  NOT_CONFIGURED
  COMMISSIONING
  ACTIVE
  FAULT
  DISABLED
}

model ModbusConfiguration {
  deviceId         String              @id
  tenantId         String
  device           Device              @relation(fields: [deviceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  configuration    Json
  profile          Json
  history          Json                @default("[]")
  revision         Int                 @default(1)
  state            CommissioningStatus @default(NOT_CONFIGURED)
  step             Int                 @default(1)
  pollingEnabled   Boolean             @default(false)
  reviewedRevision Int?
  confirmedUnitId  String?
  completedAt      DateTime?
  updatedAt        DateTime            @updatedAt

  @@unique([deviceId, tenantId])
  @@index([tenantId])
}

model ModbusDiagnostic {
  deviceId          String    @id
  tenantId          String
  device            Device    @relation(fields: [deviceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  lastPollAt        DateTime?
  lastSuccessAt     DateTime?
  responseMs        Int?
  lastError         String?
  successes         Int       @default(0)
  errors            Int       @default(0)
  consecutiveErrors Int       @default(0)
  revision          Int       @default(0)
  raw               Json

  @@unique([deviceId, tenantId])
  @@index([tenantId])
}

model TelemetrySample {
  id           String                 @id @default(cuid())
  tenantId     String
  deviceId     String
  device       Device                 @relation(fields: [deviceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  messageId    String
  timestamp    DateTime
  revision     Int
  error        String?
  measurements TechnicalMeasurement[]

  @@unique([id, tenantId])
  @@unique([tenantId, deviceId, messageId])
  @@index([tenantId, deviceId, timestamp])
}

model TechnicalMeasurement {
  id       String          @id @default(cuid())
  tenantId String
  sampleId String
  sample   TelemetrySample @relation(fields: [sampleId, tenantId], references: [id, tenantId], onDelete: Cascade)
  metric   String
  value    Decimal         @db.Decimal(20, 6)
  unit     String

  @@unique([sampleId, metric])
  @@index([tenantId, metric])
}

model GatewayCommand {
  id          String    @id @default(cuid())
  tenantId    String
  gatewayId   String
  gateway     Gateway   @relation(fields: [gatewayId, tenantId], references: [id, tenantId], onDelete: Cascade)
  deviceId    String
  device      Device    @relation(fields: [deviceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  action      String
  revision    Int
  status      String    @default("PENDING")
  error       String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  completedAt DateTime?

  @@index([tenantId, gatewayId, status])
}
