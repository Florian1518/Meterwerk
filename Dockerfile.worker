ARG VERSION=unknown
ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown
ARG GIT_WORKING_TREE=unknown

FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS build-deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS worker-build
WORKDIR /app
ARG VERSION
ARG GIT_SHA
ARG BUILD_TIMESTAMP
ARG GIT_WORKING_TREE
ENV GIT_COMMIT_SHA=$GIT_SHA BUILD_TIMESTAMP=$BUILD_TIMESTAMP GIT_WORKING_TREE=$GIT_WORKING_TREE
RUN corepack enable
COPY --from=build-deps /app/node_modules ./node_modules
COPY . .
RUN DATABASE_URL=postgresql://127.0.0.1:5432/meterwerk_build pnpm db:generate
RUN node scripts/build-worker-bundles.mjs /app/dist

FROM worker-build AS runtime-deps
WORKDIR /app
RUN node scripts/deploy-worker-runtime.mjs /app/worker-runtime

FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS runtime
WORKDIR /app
ARG VERSION
ARG GIT_SHA
ARG BUILD_TIMESTAMP
LABEL org.opencontainers.image.source=https://github.com/Florian1518/Meterwerk \
  org.opencontainers.image.version=$VERSION \
  org.opencontainers.image.revision=$GIT_SHA \
  org.opencontainers.image.created=$BUILD_TIMESTAMP \
  org.opencontainers.image.base.name=node:22-alpine
ENV NODE_ENV=production \
  BUILD_VERSION=$VERSION GIT_COMMIT_SHA=$GIT_SHA BUILD_TIMESTAMP=$BUILD_TIMESTAMP
RUN addgroup -S meterwerk && adduser -S meterwerk -G meterwerk \
  && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg
COPY --from=runtime-deps --chown=meterwerk:meterwerk /app/worker-runtime ./
USER meterwerk
ENTRYPOINT ["node", "--conditions=react-server"]
CMD ["dist/rules-worker.js"]
