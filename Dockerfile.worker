FROM node:22-alpine AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM node:22-alpine AS runtime
WORKDIR /app
RUN addgroup -S meterwerk && adduser -S meterwerk -G meterwerk
ENV NODE_ENV=production NODE_OPTIONS=--enable-source-maps
COPY --from=deps --chown=meterwerk:meterwerk /app/node_modules ./node_modules
COPY --chown=meterwerk:meterwerk package.json prisma prisma.config.ts src scripts ./
USER meterwerk
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "process.exit(0)"
ARG VERSION=unknown
ARG GIT_SHA=unknown
ENV BUILD_VERSION=$VERSION BUILD_GIT_SHA=$GIT_SHA
ENTRYPOINT ["node", "node_modules/tsx/dist/cli.mjs", "--conditions=react-server"]
