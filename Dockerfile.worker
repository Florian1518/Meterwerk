FROM node:22-alpine AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM node:22-alpine AS runtime
WORKDIR /app
RUN addgroup -S meterwerk && adduser -S meterwerk -G meterwerk
ENV NODE_ENV=production NODE_OPTIONS=--enable-source-maps
COPY --from=deps --chown=meterwerk:meterwerk /app/node_modules ./node_modules
COPY --chown=meterwerk:meterwerk package.json tsconfig.json prisma.config.ts ./
COPY --chown=meterwerk:meterwerk prisma ./prisma
COPY --chown=meterwerk:meterwerk src ./src
COPY --chown=meterwerk:meterwerk scripts ./scripts
RUN DATABASE_URL=postgresql://127.0.0.1:5432/meterwerk_build node node_modules/prisma/build/index.js generate
USER meterwerk
ARG VERSION=unknown
ARG GIT_SHA=unknown
ENV BUILD_VERSION=$VERSION GIT_COMMIT_SHA=$GIT_SHA
ENTRYPOINT ["node", "node_modules/tsx/dist/cli.mjs", "--conditions=react-server"]
