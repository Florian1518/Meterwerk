{
  "name": "meterwerk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "migration:check": "node scripts/check-migrations.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:backup": "tsx scripts/backup.ts",
    "test:pilot": "tsx --conditions=react-server tests/pilot-integration.ts",
    "test:mqtt-tls": "tsx tests/mqtt-tls.ts",
    "test:integration": "tsx --conditions=react-server tests/integration.ts && tsx --conditions=react-server tests/import-integration.ts && tsx --conditions=react-server tests/data-quality-integration.ts && tsx --conditions=react-server tests/rules-integration.ts",
    "test:field-service": "vitest run --config vitest.field-service.config.ts",
    "rules-worker": "tsx --conditions=react-server src/server/rules-worker.ts",
    "test:licensing": "tsx --conditions=react-server tests/licensing-integration.ts",
    "test:usage": "tsx --conditions=react-server tests/usage-integration.ts",
    "test:public-api": "tsx --conditions=react-server tests/public-api-integration.ts",
    "test:webhooks": "tsx --conditions=react-server tests/webhooks-integration.ts",
    "test:imports": "tsx --conditions=react-server tests/import-integration.ts",
    "test:data-quality": "vitest run tests/data-quality.test.ts",
    "test:utility": "vitest run --config vitest.utility.config.ts",
    "test:utility:http": "tsx --conditions=react-server tests/utility-http.ts",
    "test:protocol": "vitest run tests/protocol.test.ts",
    "test:protocol:integration": "tsx --conditions=react-server tests/protocol-integration.ts",
    "test:load": "tsx --conditions=react-server tests/protocol-load.ts",
    "performance:fixture": "node scripts/performance-fixture.mjs",
    "performance:gate": "node scripts/performance-regression.mjs",
    "db:local": "tsx scripts/local-db.ts",
    "test:http": "tsx --conditions=react-server tests/http.ts",
    "virtual-meter": "tsx scripts/virtual-meter.ts",
    "db:seed:utility": "tsx --conditions=react-server src/server/seed-utility.ts",
    "edge-gateway": "tsx apps/edge-gateway/src/cli.ts",
    "modbus-simulator": "tsx scripts/modbus-simulator.ts",
    "modbus:fault": "tsx scripts/simulator-fault.ts",
    "modbus:ports": "tsx scripts/serial-ports.ts",
    "mqtt-worker": "tsx --conditions=react-server src/server/mqtt-worker.ts",
    "db:seed:edge": "tsx --conditions=react-server src/server/seed-edge.ts",
    "test:gateway": "tsx --conditions=react-server tests/gateway-security.ts",
    "test:security": "tsx --conditions=react-server tests/security-integration.ts",
    "test:phase3": "tsx --conditions=react-server scripts/phase3-e2e.ts",
    "test:modbus": "tsx --conditions=react-server tests/modbus-integration.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "security:secrets": "node scripts/secret-scan.mjs",
    "security:regression": "node scripts/security-regression.mjs",
    "env:check": "node scripts/environment-guard.mjs",
    "demo:seed": "node scripts/demo-seed.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "demo:verify": "node scripts/demo-verify.mjs",
    "smoke:staging": "node scripts/smoke-staging.mjs",
    "demo:verify-all": "node scripts/demo-verify-all.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:validate": "node scripts/docs-validation.mjs",
    "acceptance:software": "node scripts/software-acceptance.mjs",
    "dr:regression": "vitest run tests/disaster-recovery.test.ts tests/dr-recovery.test.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.562.0",
    "mqtt": "^5.16.0",
    "next": "^16.1.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "serialport": "^13.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.1.0",
    "prettier": "3.8.0",
    "prisma": "^7.2.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "packageManager": "pnpm@12.5.1"
}
