{
  "name": "meterwerk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:backup": "tsx scripts/backup.ts",
    "test:pilot": "tsx --conditions=react-server tests/pilot-integration.ts",
    "test:mqtt-tls": "tsx tests/mqtt-tls.ts",
    "test:integration": "tsx --conditions=react-server tests/integration.ts",
    "db:local": "tsx scripts/local-db.ts",
    "test:http": "tsx tests/http.ts",
    "virtual-meter": "tsx scripts/virtual-meter.ts",
    "edge-gateway": "tsx apps/edge-gateway/src/cli.ts",
    "modbus-simulator": "tsx scripts/modbus-simulator.ts",
    "modbus:fault": "tsx scripts/simulator-fault.ts",
    "modbus:ports": "tsx scripts/serial-ports.ts",
    "mqtt-worker": "tsx --conditions=react-server src/server/mqtt-worker.ts",
    "db:seed:edge": "tsx --conditions=react-server src/server/seed-edge.ts",
    "test:gateway": "tsx --conditions=react-server tests/gateway-security.ts",
    "test:phase3": "tsx --conditions=react-server scripts/phase3-e2e.ts",
    "test:modbus": "tsx --conditions=react-server tests/modbus-integration.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.562.0",
    "mqtt": "^5.16.0",
    "next": "^16.1.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "serialport": "^13.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.1.0",
    "prettier": "3.8.0",
    "prisma": "^7.2.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
