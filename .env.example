# Set a local PostgreSQL URL with your own password (URL-encoded).
DATABASE_URL=""
# Same password as DATABASE_URL; required by Docker Compose.
POSTGRES_PASSWORD=""
APP_URL="http://localhost:3000"
MQTT_BROKER_URL="mqtt://127.0.0.1:1883"
# Pilot: METERWERK_ENV=pilot and mqtts://broker.example:8883.
# Separate client certificates for gateway and ingestion (see PILOT-INSTALLATION).
METERWERK_ENV="development"
MQTT_CA_PATH=""
MQTT_CERT_PATH=""
MQTT_KEY_PATH=""
MQTT_RECEIPT_KEY_PATH=".local/receipt-private.pem"
LOG_LEVEL="INFO"
# Required only for an explicit demo seed; never seed a production database.
SEED_DEMO="true"
DEMO_PASSWORD=""
# Environments: development | test | staging | demo | production
SESSION_SECRET="replace-with-secret-manager-value-at-least-32-characters"
MFA_ENCRYPTION_KEY="replace-with-32-byte-secret-manager-value"
# Production webhook signing secrets are encrypted using this independent key.
WEBHOOK_SECRET_ENCRYPTION_KEY="replace-with-independent-random-secret-manager-value"
EMAIL_PROVIDER="local"
SMTP_URL=""
EMAIL_API_URL=""
EMAIL_API_KEY=""
TRUSTED_HOSTS="localhost,127.0.0.1,app.meterwerk.de"
ATTACHMENT_STORAGE="local"
ATTACHMENT_LOCAL_ROOT=".local/attachments"
ATTACHMENT_S3_ENDPOINT=""
ATTACHMENT_S3_BUCKET=""
ATTACHMENT_S3_TOKEN=""
