# Inventory only. Copy outside the checkout, chmod 600, fill on the server.
# Empty required values deliberately prevent Compose startup. No default secrets.
STAGING_APP_URL=https://staging.fesch-elektrotechnik.de
SMOKE_BASE_URL=https://staging.fesch-elektrotechnik.de
RELEASE_VERSION=
GIT_COMMIT_SHA=
# Published from the same revision; use repository@sha256:<digest>, not tags.
METERWERK_IMAGE=
METERWERK_WORKER_IMAGE=
METERWERK_MIGRATIONS_IMAGE=
STAGING_POSTGRES_IMAGE=
STAGING_MQTT_IMAGE=
# At least 32 characters each; four independent, securely stored values.
STAGING_POSTGRES_PASSWORD=
# Configure the internal staging database connection outside the repository.
# Use host db, port 5432, and database meterwerk_staging; URL-encode credentials.
STAGING_DATABASE_URL=
STAGING_SESSION_SECRET=
MFA_ENCRYPTION_KEY=
WEBHOOK_SECRET_ENCRYPTION_KEY=
# Absolute paths outside the checkout. File mounts are read-only and must exist.
STAGING_MQTT_CONFIG=
STAGING_MQTT_ACL=
STAGING_MQTT_CA=
STAGING_MQTT_CRL=
STAGING_MQTT_SERVER_CERT=
STAGING_MQTT_SERVER_KEY=
STAGING_MQTT_CLIENT_CERT=
STAGING_MQTT_CLIENT_KEY=
STAGING_MQTT_HEALTH_CERT=
STAGING_MQTT_HEALTH_KEY=
STAGING_MQTT_RECEIPT_KEY=
# Host Apache template path inventory only; not passed to application containers.
# Replace the matching __STAGING_*__ placeholders manually in the external copy.
STAGING_WEB_TLS_CERT=
STAGING_WEB_TLS_KEY=
STAGING_ACCESS_ALLOWLIST=
